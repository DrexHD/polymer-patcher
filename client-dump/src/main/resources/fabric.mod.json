{
	"schemaVersion": 1,
	"id": "polymer-patcher-client-dump",
	"version": "${version}",
	"name": "polymer-patcher-client-dump",
	"description": "Dumps client-side classes for polymer-patcher",
	"authors": [
		"Drex"
	],
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"client": [
			"me.drex.polymerpatcher.dump.PolymerPatcherDumper"
		]
	},
	"mixins": [
		{
			"config": "polymer-patcher-client-dump.mixins.json",
			"environment": "client"
		}
	],
	"accessWidener": "polymer-patcher-client-dump.classtweaker",
	"depends": {
		"fabricloader": ">=0.18.4",
		"java": ">=21"
	}
}